#!/usr/bin/env python
from misc.utility.scons_hints import *

import os

import editor_builders

Import("env")

env.editor_sources = []

if env.editor_build:
    # Generate doc data paths
    env.CommandNoCache(
        "doc/doc_data_class_path.gen.h",
        env.Value(env.doc_class_path),
        env.Run(editor_builders.doc_data_class_path_builder),
    )

    # Register exporters (optional)
    gen_exporters = None
    if not env.get("disable_exporters", False):
        gen_exporters = env.CommandNoCache(
            "export/register_exporters.gen.cpp",
            env.Value(env.platform_exporters),
            env.Run(editor_builders.register_exporters_builder),
        )
        for e in env.platform_exporters:
            # Add all .cpp files in export folder
            env.add_source_files(env.editor_sources, f"../platform/{e}/export/*.cpp")

    # TinaGodot 2D Lite - Disable doc packaging to reduce binary size
    # Core API documentation.
    # docs = []
    # docs += Glob("#doc/classes/*.xml")

    # Module API documentation.
    # module_dirs = []
    # for d in env.doc_class_path.values():
    #     if d not in module_dirs:
    #         module_dirs.append(d)

    # for d in module_dirs:
    #     if not os.path.isabs(d):
    #         docs += Glob("#" + d + "/*.xml")  # Built-in.
    #     else:
    #         docs += Glob(d + "/*.xml")  # Custom.

    # docs = sorted(docs)

    # Generate empty doc header to disable documentation embedding
    import editor_builders
    env.CommandNoCache(
        "#editor/doc/doc_data_compressed.gen.h",
        env.Value("disabled"),
        env.Run(editor_builders.make_empty_doc_header),
    )

    # TinaGodot 2D Lite - Only include minimal Chinese editor translations to reduce binary size
    # We only include editor UI translations (zh_CN, zh_TW, zh_HK) and disable:
    # - property_translations (属性翻译, ~30MB)
    # - doc_translations (类参考文档翻译, ~50MB)
    # - extractable_translations (可提取翻译, ~20MB)
    # This saves approximately 100MB in binary size.

    def filter_chinese_translations(pattern):
        all_files = Glob(pattern)
        return [f for f in all_files if any(x in str(f) for x in ["zh_CN", "zh_TW", "zh_HK"])]

    # Only include editor UI translations, disable doc/property/extractable translations
    translation_targets = {
        "#editor/translations/editor_translations.gen.cpp": filter_chinese_translations("#editor/translations/editor/*.po"),
        # TinaGodot 2D Lite - Disabled to save ~100MB:
        # "#editor/translations/property_translations.gen.cpp": filter_chinese_translations("#editor/translations/properties/*.po"),
        # "#editor/translations/doc_translations.gen.cpp": filter_chinese_translations("#doc/translations/*.po"),
        # "#editor/translations/extractable_translations.gen.cpp": filter_chinese_translations("#editor/translations/extractable/*.po"),
    }
    for target_cpp, sources in translation_targets.items():
        target_h = os.path.splitext(target_cpp)[0] + ".h"
        env.CommandNoCache(
            [target_h, target_cpp],
            sources,
            env.Run(editor_builders.make_translations),
        )

    env.add_source_files(env.editor_sources, "*.cpp")
    if not env.get("disable_exporters", False) and gen_exporters:
        env.add_source_files(env.editor_sources, gen_exporters)
    else:
        # Provide empty stubs so editor can link without exporters.
        env.add_source_files(env.editor_sources, "#editor/export/register_exporters_stub.cpp")
    env.add_source_files(env.editor_sources, translation_targets.keys())

    SConscript("animation/SCsub")
    SConscript("asset_library/SCsub")
    # TinaFlowStudio - Removed audio editor
    # SConscript("audio/SCsub")
    SConscript("debugger/SCsub")
    SConscript("doc/SCsub")
    SConscript("docks/SCsub")
    if not env.get("disable_exporters", False):
    if not env.get("disable_exporters", False):
        SConscript("export/SCsub")
    SConscript("file_system/SCsub")
    SConscript("gui/SCsub")
    SConscript("icons/SCsub")
    SConscript("inspector/SCsub")
    SConscript("import/SCsub")
    SConscript("plugins/SCsub")
    SConscript("project_manager/SCsub")
    SConscript("project_upgrade/SCsub")
    SConscript("run/SCsub")
    SConscript("settings/SCsub")
    SConscript("scene/SCsub")
    SConscript("script/SCsub")
    SConscript("shader/SCsub")
    SConscript("themes/SCsub")
    SConscript("translations/SCsub")
    SConscript("version_control/SCsub")

    lib = env.add_library("editor", env.editor_sources)
    env.Prepend(LIBS=[lib])
